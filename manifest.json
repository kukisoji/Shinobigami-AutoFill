{
  "manifest_version": 3,
  "name": "半自動忍法概要埋め立て機",
  "description": "シノビガミのキャラシートを作成する際に、忍法欄を埋めたり、不備がないかチェックが出来ます。",
  "version": "2.3.0",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "shinobigami-autofill@kukisoji",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_title": "半自動忍法概要埋め立て機",
    "default_popup": "popup/popup.html"
  },
  "host_permissions": [
    "https://character-sheets.appspot.com/shinobigami/edit.html*"
  ],
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://character-sheets.appspot.com/shinobigami/edit.html*"
      ],
      "js": [
        "content-scripts/content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "array_data.json",
        "Ryuha_data.json",
        "Kinin_List.json",
        "Gotochi_list.json",
        "syageki_data.json",
        "syudan_data.json",
        "background_data.json"
      ],
      "matches": [
        "https://character-sheets.appspot.com/*"
      ]
    }
  ]
}
